// Fluentis — technical learning platform (NestJS + PostgreSQL)
// Frontend Next.js lives in a separate service and never talks to this database.
//
// Sequential learning (API must return 403 when this fails):
//   A lesson in module N is reachable only when every lesson in the module
//   with the same courseId and orderIndex = N - 1 has UserProgress.status =
//   COMPLETED for that user. orderIndex starts at 1; module 1 has no predecessor.
//   A CoursePlacement.startOrderIndex of S treats modules 1..S as already open.
//   Modules after S still require the previous module to be complete.
//   When the course has placement questions and the student has no placement,
//   every lesson stays locked until the placement attempt is stored.
//   The lookup key is @@unique([courseId, orderIndex]) on Module and
//   @@unique([userId, lessonId]) on UserProgress.
//   Access also requires an Enrollment with status ACTIVE, paymentStatus PAID,
//   and now() inside [accessStartsAt, accessEndsAt] (null accessEndsAt = open-ended).
//   ACTIVE is granted only by a verified Midtrans or Xendit webhook whose amount
//   matches the Payment row. The browser return URL never grants access.
//
// Video:
//   No column stores a raw .mp4 object. Playback identity lives on VideoAsset
//   as a provider asset id. The API mints a short-lived signed HLS (.m3u8) URL.
//   VideoEncryption has a single value, AES_128. The player watermark is
//   User.email + User.id and is applied at playback time, not stored here.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// .cursorrules RBAC. SUPER_ADMIN is the platform admin role.
enum Role {
  STUDENT
  INSTRUCTOR
  SUPER_ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Skill band of one course. Modules inside the course stay ordered by orderIndex.
enum SkillBand {
  FOUNDATION
  PRACTITIONER
  ADVANCED
}

/// Language of authored course material. The interface language is separate.
enum ContentLocale {
  ID
  EN
}

/// Saved interface language. Anonymous visitors use the locale cookie.
enum UiLocale {
  ID
  EN
}

/// Capstone the instructor scores after every lesson is complete.
enum ProjectKind {
  LAB_REPORT
  ANALYSIS
  DESIGN
  NOTEBOOK
}

enum LessonType {
  VIDEO
  READING
  QUIZ
}

enum StreamProvider {
  CLOUDFLARE_STREAM
}

/// HLS AES-128 only. Unencrypted or progressive MP4 is not representable.
enum VideoEncryption {
  AES_128
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  MIDTRANS
  XENDIT
}

enum PaymentChannel {
  REDIRECT
  QRIS
}

enum BadgeCode {
  LEVEL_COMPLETE
  DISTINCTION
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  role          Role      @default(STUDENT)
  /// False when an admin has deactivated the account. Login and API tokens stop.
  active        Boolean   @default(true)
  xp            Int       @default(0)
  streakCount   Int       @default(0)
  /// Calendar date of the last rewarded activity in Asia/Jakarta.
  lastActiveOn  DateTime? @db.Date
  locale        UiLocale  @default(ID)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  instructedCourses Course[]       @relation("CourseInstructor")
  enrollments       Enrollment[]
  progress          UserProgress[]
  badges            UserBadge[]
  quizAttempts      QuizAttempt[]
  certificates      Certificate[]
  passwordResets      PasswordResetToken[]
  coursePlacements    CoursePlacement[]
  projectSubmissions  PhaseProjectSubmission[]
  classMemberships    CourseClassMember[]

  @@index([role])
  @@map("users")
}

/// One-time password reset. Only the SHA-256 hash of the link token is stored.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Course {
  id           String       @id @default(uuid()) @db.Uuid
  instructorId String       @db.Uuid
  title        String
  slug         String       @unique
  description  String
  level        SkillBand
  /// Slug of a row in learning_tracks (e.g. NETWORK, DATACENTER).
  track        String
  contentLocale ContentLocale @default(ID)
  /// The other-language edition of this course, when the instructor published one.
  pairedCourseId String?       @unique @db.Uuid
  /// Whole IDR amount charged at checkout. The client cannot override it.
  price          Decimal       @db.Decimal(12, 2)
  /// Public https cover shown on the catalog. Empty when the card uses a plain panel.
  coverImageUrl  String?
  /// Course-level capaian pembelajaran.
  outcome        String?
  status         CourseStatus  @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  instructor           User                @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: Restrict)
  pairedCourse         Course?             @relation("CourseLocalePair", fields: [pairedCourseId], references: [id], onDelete: SetNull)
  localePair           Course?             @relation("CourseLocalePair")
  modules              Module[]
  enrollments          Enrollment[]
  certificates         Certificate[]
  placements           CoursePlacement[]
  placementQuestions   PlacementQuestion[]
  phaseProject         PhaseProject?
  classes              CourseClass[]

  @@index([instructorId])
  @@index([status, track])
  @@map("courses")
}

/// Catalog track shown on the home page and course filters. Managed by admins.
model LearningTrack {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  nameId    String
  nameEn    String
  blurbId   String
  blurbEn   String
  iconKey   String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
  @@map("learning_tracks")
}

model Module {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  title       String
  description String?
  /// Capaian pembelajaran for this level.
  outcome     String?
  /// 1-based, unique, and contiguous within the course.
  /// Module N stays locked until module N - 1 is fully COMPLETED,
  /// unless a course placement opens this level as the start.
  orderIndex  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, orderIndex])
  @@map("modules")
}

/// Diagnostic result. startOrderIndex is the first level the student may open
/// without completing the levels before it.
model CoursePlacement {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  courseId        String   @db.Uuid
  startOrderIndex Int
  createdAt       DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("course_placements")
}

model PlacementQuestion {
  id         String   @id @default(uuid()) @db.Uuid
  courseId   String   @db.Uuid
  prompt     String
  orderIndex Int
  createdAt  DateTime @default(now())

  course  Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  choices PlacementChoice[]

  @@unique([courseId, orderIndex])
  @@map("placement_questions")
}

model PlacementChoice {
  id               String @id @default(uuid()) @db.Uuid
  questionId       String @db.Uuid
  text             String
  /// Module orderIndex this answer recommends as the start level.
  targetOrderIndex Int
  orderIndex       Int

  question PlacementQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, orderIndex])
  @@map("placement_choices")
}

model Lesson {
  id          String     @id @default(uuid()) @db.Uuid
  moduleId    String     @db.Uuid
  title       String
  description String?
  type        LessonType
  /// 1-based position within the parent module.
  orderIndex  Int
  /// Set for QUIZ. COMPLETED is valid only when score >= passingScore.
  passingScore Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  module        Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  videoAsset    VideoAsset?
  progress      UserProgress[]
  quizAttempts  QuizAttempt[]
  quizQuestions QuizQuestion[]
  attachments   LessonAttachment[]

  @@unique([moduleId, orderIndex])
  @@map("lessons")
}

/// Supplementary lesson file. objectKey is a private storage key, never a public URL.
model LessonAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  lessonId    String   @db.Uuid
  fileName    String
  contentType String
  objectKey   String   @unique
  sizeBytes   Int
  createdAt   DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_attachments")
}

/// One row per VIDEO lesson. assetId is an opaque provider id, never a public file URL.
model VideoAsset {
  id              String          @id @default(uuid()) @db.Uuid
  lessonId        String          @unique @db.Uuid
  provider        StreamProvider
  assetId         String
  encryption      VideoEncryption @default(AES_128)
  durationSeconds Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("video_assets")
}

/// Question bank for a QUIZ lesson. Delivery order is shuffled per attempt.
model QuizQuestion {
  id         String @id @default(uuid()) @db.Uuid
  lessonId   String @db.Uuid
  prompt     String
  /// Stable authoring order. Students receive a shuffled copy.
  orderIndex Int

  lesson  Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  choices QuizChoice[]

  @@unique([lessonId, orderIndex])
  @@map("quiz_questions")
}

model QuizChoice {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @db.Uuid
  text       String
  correct    Boolean
  orderIndex Int

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, orderIndex])
  @@map("quiz_choices")
}

model UserProgress {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  lessonId     String         @db.Uuid
  status       ProgressStatus @default(NOT_STARTED)
  /// Latest score, 0–100. Null until the learner submits a quiz.
  score        Int?
  attemptCount Int            @default(0)
  completedAt  DateTime?
  /// Set once, when XP for this completion has been granted.
  rewardedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, status])
  @@index([lessonId, status])
  @@map("user_progress")
}

model UserBadge {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  code      BadgeCode
  courseId  String    @db.Uuid
  /// Module id for LEVEL_COMPLETE, lesson id for DISTINCTION.
  sourceId  String    @db.Uuid
  label     String
  awardedAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code, sourceId])
  @@index([userId, awardedAt])
  @@map("user_badges")
}

model QuizAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  lessonId  String   @db.Uuid
  score     Int
  passed    Boolean
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("quiz_attempts")
}

/// Issued once, when every lesson in the course is COMPLETED.
model Certificate {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  courseId String   @db.Uuid
  issuedAt DateTime @default(now())
  /// PDF rendered from the HTML template when the course is completed.
  pdfBytes Bytes?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@index([userId, issuedAt])
  @@map("certificates")
}

/// One culminating task for the course phase. Students submit after every lesson is complete.
model PhaseProject {
  id        String      @id @default(uuid()) @db.Uuid
  courseId  String      @unique @db.Uuid
  title     String
  prompt    String
  kind      ProjectKind
  rubric    String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  course      Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions PhaseProjectSubmission[]

  @@map("phase_projects")
}

model PhaseProjectSubmission {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  userId      String    @db.Uuid
  response    String
  score       Int?
  feedback    String?
  submittedAt DateTime  @default(now())
  scoredAt    DateTime?

  project PhaseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("phase_project_submissions")
}

/// A named class inside one course. Membership does not grant access by itself.
model CourseClass {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())

  course  Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  members CourseClassMember[]

  @@unique([courseId, name])
  @@map("course_classes")
}

model CourseClassMember {
  id        String   @id @default(uuid()) @db.Uuid
  classId   String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  courseClass CourseClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([userId])
  @@map("course_class_members")
}

model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  courseId       String           @db.Uuid
  /// Latest payment order. Historical attempts live on Payment.orderId.
  orderId        String           @unique
  status         EnrollmentStatus @default(PENDING)
  paymentStatus  PaymentStatus    @default(UNPAID)
  amount         Decimal          @db.Decimal(12, 2)
  currency       String           @default("IDR") @db.Char(3)
  providerRef    String?
  paidAt         DateTime?
  accessStartsAt DateTime?
  accessEndsAt   DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@unique([userId, courseId])
  @@index([userId, status])
  @@index([courseId, paymentStatus])
  @@map("enrollments")
}

/// One gateway charge. Webhooks resolve this row by orderId, then grant access.
model Payment {
  id           String          @id @default(uuid()) @db.Uuid
  enrollmentId String          @db.Uuid
  orderId      String          @unique
  provider     PaymentProvider
  channel      PaymentChannel  @default(REDIRECT)
  amount       Decimal         @db.Decimal(12, 2)
  currency     String          @default("IDR") @db.Char(3)
  status       PaymentStatus   @default(PENDING)
  checkoutUrl  String?
  /// EMV QRIS payload. Present only when channel is QRIS.
  qrString     String?         @db.Text
  providerRef  String?
  paidAt       DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, status])
  @@map("payments")
}

/// Security monitoring. actorId is omitted when the account is unknown, such as a failed login.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  resource  String
  outcome   String
  ip        String?
  detail    String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Platform configuration. Secret fields inside value are sealed before they are stored.
model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}
