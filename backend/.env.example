DATABASE_URL=postgresql://fluentis:fluentis@localhost:5432/fluentis
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-secret-of-at-least-32-chars
PORT=3001
# lax for localhost and same-site subdomains. none only with HTTPS and COOKIE_SECURE.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
PAYMENT_PROVIDER=midtrans
MIDTRANS_SERVER_KEY=SB-Mid-server-change-this-key
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_QRIS_ACQUIRER=gopay
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
# mock = local playback after guards. cloudflare = signed Stream tokens.
VIDEO_MODE=mock
MOCK_HLS_MANIFEST_URL=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_PRIVATE_KEY=
# Optional. Puppeteer uses its downloaded Chrome, then Google Chrome on this machine.
PUPPETEER_EXECUTABLE_PATH=
# log skips delivery. resend sends transactional mail and requires RESEND_API_KEY plus MAIL_FROM.
MAIL_PROVIDER=log
RESEND_API_KEY=
MAIL_FROM=
# Optional. Unset REDIS_URL keeps every request on PostgreSQL.
REDIS_URL=
# Optional. Unset SENTRY_DSN logs server errors locally.
SENTRY_DSN=
# local keeps lesson files on disk. s3 uses a private S3 or Cloudflare R2 bucket.
ATTACHMENT_STORAGE=local
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set for Cloudflare R2, for example https://<accountid>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT=
