# Copy to the repository root as `.env` before `docker compose up`.
# Compose reads this file for ${...} substitution. Do not commit the copy.
#
#   cp deploy/env.example .env

# --- Database (hostname inside Compose is `postgres`, not localhost) ---
POSTGRES_USER=fluentis
POSTGRES_PASSWORD=
POSTGRES_DB=fluentis

# --- Public URLs ---
# Browser origin of the Next.js app. One origin only. No trailing slash.
# Local Docker:  http://localhost:3000
# Production:    https://auralogic.web.id
FRONTEND_ORIGIN=http://localhost:3000

# Baked into the frontend at image build time. Must include /api.
# Local Docker:  http://localhost:3001/api
# Production:    https://api.auralogic.web.id/api
# Rebuild the frontend after changing this value.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# --- Auth cookies ---
# At least 32 characters. Replacing it signs everyone out.
JWT_SECRET=
# lax works for app.example.com + api.example.com (same site, different subdomains).
COOKIE_SAMESITE=lax
# Set true when the public site is HTTPS.
COOKIE_SECURE=false
# Required when the site and API are different subdomains. Empty on localhost.
# Production: .auralogic.web.id
COOKIE_DOMAIN=

# --- Payments (webhook must hit the public API, not the Docker hostname) ---
# Midtrans POST: https://api.auralogic.web.id/api/payments/midtrans/notification
# Xendit POST:   https://api.auralogic.web.id/api/payments/xendit/invoices
#                https://api.auralogic.web.id/api/payments/xendit/qris
# A browser GET of the Midtrans URL returns {"status":"ok","accept":"POST"}.
PAYMENT_PROVIDER=midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_QRIS_ACQUIRER=gopay
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# --- Video ---
# mock serves a test HLS manifest after enrollment and prerequisite checks.
# cloudflare uses Cloudflare Stream signed URLs.
VIDEO_MODE=mock
MOCK_HLS_MANIFEST_URL=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_PRIVATE_KEY=

# --- Mail ---
# log prints messages in the API container logs. resend delivers them.
MAIL_PROVIDER=log
RESEND_API_KEY=
MAIL_FROM=

# --- Optional ---
SENTRY_DSN=

# Lesson files. local uses the attachment_data volume. s3 uses a private bucket or R2.
ATTACHMENT_STORAGE=local
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
